# Journal / original Obsidian vault. Used once to copy notes into the Google Drive folder.
# Optional when the vault sits next to this repo as ../investment-vault.
VAULT_PATH=

# Optional SQLite file path. Overrides the Google Drive folder set in Settings.
# DATABASE_PATH=

# Preferred: in Settings, set the Google Drive mirrored folder, e.g.
#   C:\Users\ht.tu\My Drive\Northstar
# Northstar will use:
#   <folder>/dashboard.db   (watchlist)
#   <folder>/Vault/         (Markdown notes, shared with Obsidian)
