# Optional when the vault sits next to this repo as ../investment-vault.
VAULT_PATH=

# Optional SQLite file path. Overrides the Google Drive folder set in Settings.
# DATABASE_PATH=

# Preferred: in Settings, set the Google Drive mirrored folder.
# Northstar will use <folder>/dashboard.db (a single small SQLite file).
